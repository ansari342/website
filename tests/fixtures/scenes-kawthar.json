      { "n": 1, "meaning": "Allah has granted the Prophet al-Kawthar, a river and abundant good.", "image": "A river descends from a source of light and widens into many streams that fill the frame." },
      { "n": 2, "meaning": "So pray to your Lord and sacrifice for Him alone, in gratitude.", "image": "The river settles into a still pool before a prayer niche; light falls into the niche and ripples outward." },
      { "n": 3, "meaning": "The one who hates you is the one cut off, without legacy.", "image": "A tree away from the river withers and is severed; its crown scatters while the river keeps flowing at the edge." }
    ]
  },
